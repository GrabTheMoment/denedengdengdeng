PORT=3000
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# —— Supabase Storage（可选）：相册上传聊天背景 / 朋友圈配图等写入云端时的 bucket 名 ——
# 在控制台 Storage 里创建的 bucket 名称填到下一行；留空则上传到本机 public/uploads（云上重启易丢）
# 示例：CHAT_BG_STORAGE_BUCKET=silas-chat-bg
CHAT_BG_STORAGE_BUCKET=

# 云上 / 新库：在 Supabase → SQL 执行本仓库 supabase/schema.sql，或按需执行各 migration_*.sql（含 migration_memo_pad.sql 等）

# OpenAI（聊天与朋友圈 AI 互动）：在 https://platform.openai.com/api-keys 创建密钥，粘贴到下一行
OPENAI_API_KEY=
# 默认 https://api.openai.com/v1；若本机直连失败，可改为你的 OpenAI 兼容中转 base（不要末尾斜杠）
OPENAI_BASE_URL=https://api.openai.com/v1
# 本机有 Clash / v2rayN 等时，填其「HTTP 代理」端口（常见 7890、10809 等，以软件显示为准）。Node 会通过 undici 走此代理访问 OpenAI。
# HTTPS_PROXY=http://127.0.0.1:7890
# GPT-4o mini（口语里的「4o mini」）在 API 中的 id：
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
# 毫秒，防止请求一直挂起导致手机浏览器显示 fetch failed
OPENAI_TIMEOUT_MS=55000

# 长期记忆：送入模型的「近期」消息条数上限（仅当前会话，默认与 MEMORY_RECENT_MESSAGES 对齐）
# CHAT_HISTORY_MESSAGES=18
# MEMORY_RECENT_MESSAGES=18
# 跨会话时间线：全局保留最近多少条消息不进入「待摘要」池（所有会话合计）
# MEMORY_RECENT_GLOBAL_MESSAGES=32
# 满多少「轮」对话提示合并长期记忆（一轮 = 用户一条 + 其后连续助手消息直到下一条用户），默认 100
# MEMORY_DIGEST_BATCH_ROUNDS=100
# 自动摘要正文最大字符（写入 memory_auto_digest）
# MEMORY_AUTO_DIGEST_MAX_CHARS=3500

# Editorial 聊天背景图：可填公网 https 图片 URL；数据库 app_profile.chat_bg_image_url 未配置时前端会用此默认值（适合云部署一条环境变量搞定）
# CHAT_BG_IMAGE_URL=https://example.com/your-bg.jpg

# （已在上方列出 CHAT_BG_STORAGE_BUCKET；与 Supabase 控制台里 bucket 名称一致即可）

# 上传后的浏览器访问根地址（反代、CDN 时若 req.host 不对可手动指定）
# PUBLIC_BASE_URL=https://chat.example.com

# 用户发朋友圈后，约多少分钟再由 AI 点赞/评论（服务端轮询触发）
MOMENT_AI_DELAY_MINUTES=10
# 检查「已到互动时间」的动态，毫秒（默认 60 秒）
MOMENT_AI_POLL_INTERVAL_MS=60000

# AI 自行更新个性签名 / 头像（从头像候选 URL 中选）：设为 0 关闭
# AI_SELF_UPDATE_ENABLED=1
# 设为 0 时：个性签名不会被自动逻辑改写（你在「我」里保存为准）
# AI_SELF_UPDATE_SIGNATURE=0
# 设为 0 时：头像不会被自动逻辑修改（含候选图切换）
# AI_SELF_UPDATE_AVATAR=0
# 说明：在「我」里填写的 AI 头像若不是下列候选之一，也会视为手动图，自动逻辑不会替换。
# 两次成功更新之间的最短间隔（毫秒，默认约 30 天）
# AI_SELF_UPDATE_MIN_GAP_MS=2592000000
# 随机定时触发的间隔范围（毫秒，默认约 26～34 天）
# AI_SELF_UPDATE_MIN_MS=2246400000
# AI_SELF_UPDATE_MAX_MS=2937600000
# 逗号分隔的 https 头像 URL 列表；不配则使用内置 Dicebear 候选图
# AI_AVATAR_CANDIDATES=https://...,https://...

# 本仓库未实现「AI 执行本机 Shell / OpenClaw 式任意命令」：浏览器与 Node 若直连执行用户机器上的程序，安全风险极高。
# 若你需要自动化，请在隔离环境自行扩展，并严格限制白名单与审计。

# —— Silas 主动发消息（服务端定时写库；需 npm run dev / node 进程常驻 + OPENAI_API_KEY）——
# 设为 1 开启；默认关闭
# SILAS_PROACTIVE_ENABLED=1
# 判断「高峰 / 低谷」用的 IANA 时区（默认与大陆常用一致）
# SILAS_PROACTIVE_TZ=Asia/Shanghai
# 高峰窗口（本地时区）默认 10:00–23:30：约每 30–60 分钟尝试一次（随机）
# SILAS_PROACTIVE_PEAK_START=10:00
# SILAS_PROACTIVE_PEAK_END=23:30
# SILAS_PROACTIVE_PEAK_MIN_MS=1800000
# SILAS_PROACTIVE_PEAK_MAX_MS=3600000
# 低谷：约每 3–6 小时尝试一次（随机）
# SILAS_PROACTIVE_OFF_MIN_MS=10800000
# SILAS_PROACTIVE_OFF_MAX_MS=21600000
# 若该会话任意一方在 N 分钟内发过消息，则推迟主动发（避免叠在你正在聊的时候）
# SILAS_PROACTIVE_IDLE_MINUTES=25
# 主动消息写入的会话 id（留空则用默认「与 Silas」会话）
# SILAS_PROACTIVE_CONVERSATION_ID=

# 可选：设置后前端需密码登录；不设则仅本地调试免登录（勿用于公网）
APP_PASSWORD=
JWT_SECRET=
